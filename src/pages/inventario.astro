---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getAllMaquetas } from "@/lib/content";
import { withBase } from "@/lib/path";

const maquetas = [...await getAllMaquetas()].sort((left, right) =>
  left.title.localeCompare(right.title, "es", { sensitivity: "base" }),
);
---

<BaseLayout
  title="Inventario"
  description="Indice alfabetico con el inventario completo de maquetas publicadas en la web."
>
  <section class="mx-auto max-w-7xl px-4 pb-20 pt-12 sm:px-6 lg:px-8 lg:pt-16">
    <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <p class="eyebrow">Inventario</p>
        <h1 class="mt-2 text-6xl leading-[0.95] text-[var(--color-wood-deep)]">Indice completo de maquetas</h1>
      </div>
      <p class="max-w-2xl text-sm leading-7 text-[rgba(33,26,22,0.78)]">
        Este apartado reune todo el inventario publicado en la web en un listado alfabetico y enlazado, util para consulta rapida.
      </p>
    </div>

    <div class="panel-surface mt-10 rounded-[2rem] p-6 sm:p-8">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-sm uppercase tracking-[0.16em] text-[rgba(33,26,22,0.54)]">Total de fichas</p>
          <p class="mt-3 font-serif text-5xl text-[var(--color-wood-deep)]">{maquetas.length}</p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a class="button-link button-primary" href={withBase("/catalogo")}>Abrir catalogo con filtros</a>
          <a class="button-link button-secondary" href={withBase("/noticias")}>Ver noticias</a>
        </div>
      </div>
    </div>

    <ol class="mt-10 grid gap-4">
      {maquetas.map((maqueta, index) => (
        <li class="panel-surface rounded-[1.6rem] p-5 sm:p-6">
          <div class="grid gap-4 lg:grid-cols-[5rem_minmax(0,2fr)_minmax(0,1.1fr)_minmax(0,1fr)] lg:items-center">
            <p class="text-sm uppercase tracking-[0.16em] text-[rgba(33,26,22,0.46)]">{String(index + 1).padStart(2, "0")}</p>
            <div>
              <a class="font-serif text-3xl text-[var(--color-wood-deep)] hover:text-[var(--color-accent)]" href={withBase(`/maquetas/${maqueta.slug}`)}>
                {maqueta.title}
              </a>
              <p class="mt-2 text-sm leading-7 text-[rgba(33,26,22,0.78)]">{maqueta.summary}</p>
            </div>
            <div class="text-sm leading-7 text-[rgba(33,26,22,0.78)]">
              <p class="font-semibold uppercase tracking-[0.14em] text-[rgba(33,26,22,0.48)]">Localizacion</p>
              <p class="mt-1">{maqueta.municipality}, {maqueta.province}</p>
            </div>
            <div class="text-sm leading-7 text-[rgba(33,26,22,0.78)]">
              <p class="font-semibold uppercase tracking-[0.14em] text-[rgba(33,26,22,0.48)]">Tipo</p>
              <p class="mt-1">{maqueta.buildingType}</p>
              <p>{maqueta.yearCreated ? `Ano ${maqueta.yearCreated}` : "Sin fecha documentada"}</p>
            </div>
          </div>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>