---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getAllMaquetas } from "@/lib/content";
import { manualInventoryEntries } from "@/lib/manualInventory.mjs";
import { withBase } from "@/lib/path";

const maquetas = [...await getAllMaquetas()].sort((left, right) =>
  left.title.localeCompare(right.title, "es", { sensitivity: "base" }),
);
const maquetasBySlug = new Map(maquetas.map((maqueta) => [maqueta.slug, maqueta]));
const indexedEntries = manualInventoryEntries
  .map((entry, index) => ({
    ...entry,
    index: index + 1,
    maqueta: maquetasBySlug.get(entry.slug),
  }))
  .filter((entry) => entry.maqueta);
const indexedSlugs = new Set(indexedEntries.map((entry) => entry.slug));
const remainingMaquetas = maquetas.filter((maqueta) => !indexedSlugs.has(maqueta.slug));
---

<BaseLayout
  title="Inventario"
  description="Índice numerado con la recopilación principal de maquetas y enlaces directos a cada ficha del catálogo."
>
  <section class="mx-auto max-w-7xl px-4 pb-20 pt-12 sm:px-6 lg:px-8 lg:pt-16">
    <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <p class="eyebrow">Inventario</p>
        <h1 class="mt-2 text-6xl leading-[0.95] text-[var(--color-wood-deep)]">Índice numerado de maquetas</h1>
      </div>
      <p class="max-w-2xl text-sm leading-7 text-[rgba(33,26,22,0.78)]">
        El listado principal sigue la recopilación manual facilitada para esta colección y enlaza cada entrada con su ficha ya fusionada en la web. Al final se añaden las fichas complementarias que no aparecían en ese índice base.
      </p>
    </div>

    <div class="panel-surface mt-10 rounded-[2rem] p-6 sm:p-8">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-sm uppercase tracking-[0.16em] text-[rgba(33,26,22,0.54)]">Entradas del índice base</p>
          <p class="mt-3 font-serif text-5xl text-[var(--color-wood-deep)]">{indexedEntries.length}</p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a class="button-link button-primary" href={withBase("/catalogo")}>Abrir catalogo con filtros</a>
          <a class="button-link button-secondary" href={withBase("/noticias")}>Ver noticias</a>
        </div>
      </div>
    </div>

    <ol class="mt-10 grid gap-4">
      {indexedEntries.map((entry) => (
        <li class="panel-surface rounded-[1.6rem] p-5 sm:p-6">
          <div class="grid gap-4 lg:grid-cols-[5rem_minmax(0,2fr)_minmax(0,1.1fr)_minmax(0,1fr)] lg:items-center">
            <p class="text-sm uppercase tracking-[0.16em] text-[rgba(33,26,22,0.46)]">{String(entry.index).padStart(2, "0")}</p>
            <div>
              <a class="font-serif text-3xl text-[var(--color-wood-deep)] hover:text-[var(--color-accent)]" href={withBase(`/maquetas/${entry.slug}`)}>
                {entry.label}
              </a>
              {entry.label !== entry.maqueta.title && (
                <p class="mt-2 text-xs uppercase tracking-[0.16em] text-[rgba(33,26,22,0.48)]">Ficha actual: {entry.maqueta.title}</p>
              )}
              <p class="mt-2 text-sm leading-7 text-[rgba(33,26,22,0.78)]">{entry.maqueta.summary}</p>
            </div>
            <div class="text-sm leading-7 text-[rgba(33,26,22,0.78)]">
              <p class="font-semibold uppercase tracking-[0.14em] text-[rgba(33,26,22,0.48)]">Localizacion</p>
              <p class="mt-1">{entry.maqueta.municipality}, {entry.maqueta.province}</p>
            </div>
            <div class="text-sm leading-7 text-[rgba(33,26,22,0.78)]">
              <p class="font-semibold uppercase tracking-[0.14em] text-[rgba(33,26,22,0.48)]">Tipo</p>
              <p class="mt-1">{entry.maqueta.buildingType}</p>
              <p>{entry.maqueta.yearCreated ? `Ano ${entry.maqueta.yearCreated}` : "Sin fecha documentada"}</p>
            </div>
          </div>
        </li>
      ))}
    </ol>

    {remainingMaquetas.length > 0 && (
      <section class="mt-14">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="eyebrow">Fichas complementarias</p>
            <h2 class="mt-2 text-4xl text-[var(--color-wood-deep)]">Piezas añadidas fuera del índice base</h2>
          </div>
          <p class="max-w-2xl text-sm leading-7 text-[rgba(33,26,22,0.76)]">
            Este bloque reúne fichas existentes o nuevas que no figuraban de forma explícita en la recopilación numerada inicial, pero sí forman parte del catálogo final publicado.
          </p>
        </div>

        <ol class="mt-8 grid gap-4">
          {remainingMaquetas.map((maqueta, index) => (
            <li class="panel-surface rounded-[1.6rem] p-5 sm:p-6">
              <div class="grid gap-4 lg:grid-cols-[5rem_minmax(0,2fr)_minmax(0,1.1fr)_minmax(0,1fr)] lg:items-center">
                <p class="text-sm uppercase tracking-[0.16em] text-[rgba(33,26,22,0.46)]">{String(indexedEntries.length + index + 1).padStart(2, "0")}</p>
                <div>
                  <a class="font-serif text-3xl text-[var(--color-wood-deep)] hover:text-[var(--color-accent)]" href={withBase(`/maquetas/${maqueta.slug}`)}>
                    {maqueta.title}
                  </a>
                  <p class="mt-2 text-sm leading-7 text-[rgba(33,26,22,0.78)]">{maqueta.summary}</p>
                </div>
                <div class="text-sm leading-7 text-[rgba(33,26,22,0.78)]">
                  <p class="font-semibold uppercase tracking-[0.14em] text-[rgba(33,26,22,0.48)]">Localizacion</p>
                  <p class="mt-1">{maqueta.municipality}, {maqueta.province}</p>
                </div>
                <div class="text-sm leading-7 text-[rgba(33,26,22,0.78)]">
                  <p class="font-semibold uppercase tracking-[0.14em] text-[rgba(33,26,22,0.48)]">Tipo</p>
                  <p class="mt-1">{maqueta.buildingType}</p>
                  <p>{maqueta.yearCreated ? `Ano ${maqueta.yearCreated}` : "Sin fecha documentada"}</p>
                </div>
              </div>
            </li>
          ))}
        </ol>
      </section>
    )}
  </section>
</BaseLayout>