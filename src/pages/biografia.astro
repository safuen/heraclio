---
import BaseLayout from "@/layouts/BaseLayout.astro";
import RichText from "@/components/RichText.astro";
import { getBiography } from "@/lib/content";

const biography = await getBiography();
---

<BaseLayout title="Biografía" description={biography.summary}>
  <section class="mx-auto max-w-5xl px-4 pb-16 pt-12 sm:px-6 lg:px-8 lg:pt-16">
    <div class="panel-surface rounded-[2.4rem] p-8 sm:p-10">
      <p class="eyebrow">Biografía</p>
      <h1 class="mt-3 text-6xl leading-[0.95] text-[var(--color-wood-deep)]">{biography.title}</h1>
      <p class="mt-6 max-w-3xl text-lg leading-8 text-[rgba(33,26,22,0.82)]">{biography.summary}</p>

      <div class="mt-10 grid gap-6 md:grid-cols-2">
        <div class="rounded-[1.6rem] border border-[rgba(65,42,28,0.08)] bg-white/55 p-6">
          <h2 class="text-3xl text-[var(--color-wood-deep)]">Trayectoria</h2>
          <ul class="mt-4 space-y-3 text-sm leading-7 text-[rgba(33,26,22,0.78)]">
            {biography.milestones.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div class="rounded-[1.6rem] border border-[rgba(65,42,28,0.08)] bg-white/55 p-6">
          <h2 class="text-3xl text-[var(--color-wood-deep)]">Técnicas y materiales</h2>
          <ul class="mt-4 space-y-3 text-sm leading-7 text-[rgba(33,26,22,0.78)]">
            {[...biography.techniques, ...biography.materials].map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>

      <div class="mt-8 rounded-[1.8rem] border border-[rgba(65,42,28,0.08)] bg-white/55 p-6 sm:p-8">
        <h2 class="text-4xl text-[var(--color-wood-deep)]">Motivación y proceso de construcción</h2>
        <div class="mt-6">
          <RichText html={biography.html} />
        </div>
      </div>

      {biography.process.length > 0 && (
        <div class="mt-8 rounded-[1.8rem] border border-[rgba(65,42,28,0.08)] bg-white/55 p-6 sm:p-8">
          <h2 class="text-4xl text-[var(--color-wood-deep)]">Proceso habitual</h2>
          <ol class="mt-6 space-y-3 text-sm leading-7 text-[rgba(33,26,22,0.8)]">
            {biography.process.map((item, index) => <li>{index + 1}. {item}</li>)}
          </ol>
        </div>
      )}
    </div>
  </section>
</BaseLayout>