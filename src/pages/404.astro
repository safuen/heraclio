---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { withBase } from "@/lib/path";
---

<BaseLayout title="Página no encontrada" description="La página solicitada no existe o aún no forma parte del catálogo.">
  <section class="mx-auto flex max-w-4xl flex-col items-center px-4 pb-20 pt-20 text-center sm:px-6 lg:px-8">
    <div class="panel-surface w-full rounded-[2.4rem] px-8 py-14">
      <p class="eyebrow">404</p>
      <h1 class="mt-3 text-6xl text-[var(--color-wood-deep)]">La ficha que busca no está disponible</h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-[rgba(33,26,22,0.78)]">
        Compruebe la dirección o vuelva al catálogo principal para navegar por las maquetas publicadas.
      </p>
      <div class="mt-8 flex justify-center">
        <a class="button-link button-primary" href={withBase("/catalogo")}>Ir al catálogo</a>
      </div>
    </div>
  </section>
</BaseLayout>