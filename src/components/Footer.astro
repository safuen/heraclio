---
import { withBase } from "@/lib/path";
import siteConfig from "@/site.config";

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-[rgba(65,42,28,0.1)] bg-[rgba(239,230,216,0.64)]">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 py-10 sm:px-6 lg:grid-cols-[1.6fr_1fr_1fr] lg:px-8">
    <div>
      <p class="font-serif text-2xl font-semibold text-[var(--color-wood-deep)]">Catálogo digital de patrimonio</p>
      <p class="mt-3 max-w-xl text-sm leading-7 text-[rgba(33,26,22,0.8)]">
        Archivo estático dedicado a las maquetas artesanales en madera de Heraclio Rodríguez García.
        El proyecto prioriza legibilidad, accesibilidad y mantenimiento sencillo a partir de archivos Markdown e imágenes.
      </p>
    </div>

    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[var(--color-accent)]">Navegación</p>
      <ul class="mt-4 space-y-3 text-sm text-[rgba(33,26,22,0.82)]">
        <li><a class="hover:text-[var(--color-wood-deep)]" href={withBase("/")}>Inicio</a></li>
        <li><a class="hover:text-[var(--color-wood-deep)]" href={withBase("/biografia")}>Biografía</a></li>
        <li><a class="hover:text-[var(--color-wood-deep)]" href={withBase("/catalogo")}>Catálogo completo</a></li>
      </ul>
    </div>

    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[var(--color-accent)]">Fuentes de referencia</p>
      <ul class="mt-4 space-y-3 text-sm text-[rgba(33,26,22,0.82)]">
        <li><a class="hover:text-[var(--color-wood-deep)]" href={siteConfig.social.wixArchive} target="_blank" rel="noreferrer">Archivo histórico en Wix</a></li>
        <li><a class="hover:text-[var(--color-wood-deep)]" href={siteConfig.social.facebook} target="_blank" rel="noreferrer">Página de Facebook</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-[rgba(65,42,28,0.08)] px-4 py-4 text-center text-xs tracking-[0.16em] text-[rgba(33,26,22,0.62)] sm:px-6 lg:px-8">
    © {year} {siteConfig.author}. Sitio estático preparado para GitHub Pages.
  </div>
</footer>