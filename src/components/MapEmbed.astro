---
interface Props {
  query: string;
  title: string;
}

const { query, title } = Astro.props;
const src = `https://www.google.com/maps?q=${encodeURIComponent(query)}&z=15&output=embed`;
---

<section aria-labelledby="ubicacion" class="panel-surface rounded-[2rem] p-6 sm:p-8">
  <p class="eyebrow">Ubicación</p>
  <h2 id="ubicacion" class="mt-2 text-4xl text-[var(--color-wood-deep)]">Localización del edificio original</h2>
  <p class="mt-3 max-w-3xl text-sm leading-7 text-[rgba(33,26,22,0.76)]">
    Se muestra un mapa únicamente cuando la identificación del edificio es clara y se dispone de una referencia fiable de su emplazamiento actual.
  </p>
  <div class="mt-8 overflow-hidden rounded-[1.5rem] border border-[rgba(65,42,28,0.08)]">
    <iframe
      class="h-[22rem] w-full"
      title={`Mapa de ${title}`}
      src={src}
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
    />
  </div>
</section>