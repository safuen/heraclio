---
import { withBase } from "@/lib/path";
import ResponsiveImage from "@/components/ResponsiveImage.astro";
import type { Maqueta } from "@/lib/types";

interface Props {
  maqueta: Maqueta;
}

const { maqueta } = Astro.props;
const destination = withBase(`/maquetas/${maqueta.slug}`);
const searchableText = [maqueta.title, maqueta.municipality, maqueta.province, maqueta.buildingType, ...(maqueta.tags ?? [])]
  .filter(Boolean)
  .join(" ")
  .toLowerCase();
---

<article
  class="panel-surface group flex h-full flex-col overflow-hidden rounded-[1.6rem]"
  data-filter-card
  data-search={searchableText}
  data-municipality={maqueta.municipality}
  data-type={maqueta.buildingType}
  data-year={maqueta.yearCreated ? String(maqueta.yearCreated) : "sin-fecha"}
  data-province={maqueta.province}
>
  <a class="flex h-full flex-col" href={destination}>
    <div class="relative overflow-hidden p-3">
      {maqueta.coverImage ? (
        <div class="image-frame overflow-hidden">
          <ResponsiveImage
            class="aspect-[4/3] object-cover transition duration-500 group-hover:scale-[1.03]"
            image={maqueta.coverImage}
            sizes="(min-width: 1280px) 30vw, (min-width: 768px) 45vw, 100vw"
          />
        </div>
      ) : (
        <div class="placeholder-tile aspect-[4/3]">
          <div>
            <p class="eyebrow text-[rgba(255,244,230,0.72)]">Sin imagen clasificada</p>
            <p class="mt-2 font-serif text-2xl">{maqueta.title}</p>
          </div>
        </div>
      )}
    </div>

    <div class="flex flex-1 flex-col gap-4 px-5 pb-5 pt-1">
      <div>
        <p class="eyebrow">{maqueta.buildingType}</p>
        <h3 class="mt-2 text-3xl leading-tight text-[var(--color-wood-deep)]">{maqueta.title}</h3>
        <p class="mt-2 text-sm text-[rgba(33,26,22,0.74)]">{maqueta.municipality}, {maqueta.province}</p>
      </div>

      <p class="text-sm leading-7 text-[rgba(33,26,22,0.82)]">{maqueta.summary}</p>

      <div class="mt-auto flex items-center justify-between gap-4 border-t border-[rgba(65,42,28,0.08)] pt-4 text-sm text-[rgba(33,26,22,0.72)]">
        <span>{maqueta.yearCreated ? `Realizada en ${maqueta.yearCreated}` : "Fecha no documentada"}</span>
        <span class="font-semibold text-[var(--color-wood-deep)]">Ver ficha</span>
      </div>
    </div>
  </a>
</article>