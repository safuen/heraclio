---
import type { SiteStats } from "@/lib/types";

interface Props {
  stats: SiteStats;
}

const { stats } = Astro.props;

const items = [
  { label: "Maquetas catalogadas", value: stats.total },
  { label: "Municipios representados", value: stats.municipalities },
  { label: "Edificios religiosos", value: stats.religious },
  { label: "Edificios civiles", value: stats.civil },
];
---

<section aria-labelledby="estadisticas-titulo" class="panel-surface rounded-[2rem] px-6 py-8 sm:px-8">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="eyebrow">Estadísticas automáticas</p>
      <h2 id="estadisticas-titulo" class="mt-2 text-4xl text-[var(--color-wood-deep)]">Una colección ordenada como un archivo expositivo</h2>
    </div>
    <p class="max-w-xl text-sm leading-7 text-[rgba(33,26,22,0.78)]">
      Los recuentos se generan directamente desde los archivos Markdown. Al añadir una ficha nueva, las cifras se actualizan sin tocar el diseño.
    </p>
  </div>

  <div class="mt-8 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
    {items.map((item) => (
      <div class="rounded-[1.5rem] border border-[rgba(65,42,28,0.08)] bg-white/55 p-5">
        <p class="text-sm uppercase tracking-[0.14em] text-[rgba(33,26,22,0.58)]">{item.label}</p>
        <p class="mt-3 font-serif text-5xl text-[var(--color-wood-deep)]">{item.value}</p>
      </div>
    ))}
  </div>
</section>